# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 运行 / 冒烟日志（不入库：可能含请求数据等敏感输出）
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite 数据库 / 运行期数据（绝不入库：含真实数据）
*.db
*.db-journal
*.db-wal
/data/
/prisma/*.db

# agent / 本地杂项
.claude/

# 保留示例环境文件（上面的 .env* 会把它也忽略，这里放行；它不含真实密钥）
!.env.example
